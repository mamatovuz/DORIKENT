# ==== TELEGRAM BOT ====
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Admin Telegram ID lari (vergul bilan ajrating). O'z ID ni @userinfobot dan oling.
ADMIN_IDS=123456789

# ==== AI (ixtiyoriy) ====
# Ikkalasidan biri ishlasa yetarli. Ikkalasi ham bo'sh bo'lsa AI-siz generator ishlaydi.
# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (ChatGPT) API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI qaysi tartibda sinab ko'rilsin: gemini,openai  yoki  openai,gemini
AI_ORDER=gemini,openai

# ==== DEFAULT TEST SOZLAMALARI ====
DEFAULT_QUESTIONS_PER_TEST=20
DEFAULT_PASS_PERCENT=70
DEFAULT_TIME_PER_QUESTION=30
DEFAULT_ALLOW_RETAKE=1
DEFAULT_SHOW_RESULT=1

# ==== RECRUITMENT INTEGRATSIYASI (2-bot / Ish topish boti) ====
# 1-bot ichidagi API server (2-bot shu API orqali bog'lanadi).
# Kuchli, tasodifiy secret qo'ying (masalan: openssl rand -hex 32).
TEST_API_SECRET=change_this_to_strong_secret
API_HOST=0.0.0.0
API_PORT=8080
API_ENABLED=1

# Bot username (@ siz) — deep link yasash uchun: https://t.me/<username>?start=test_<id>
BOT_USERNAME=DoriKentTestBot

# 2-bot (Ish topish boti) API — test natijasini yuborish uchun.
# Endpoint: POST <RECRUITMENT_API_URL>/api/v1/test-results
RECRUITMENT_API_URL=https://dorikent.up.railway.app
RECRUITMENT_API_SECRET=
